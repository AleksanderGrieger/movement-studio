# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# large source media — kept out of git; see assets-source/README.md
assets-source/video/

# verification artefacts
.shots/

# build-time content snapshot — fetched from the CMS by npm run content:fetch.
# Not committed on purpose: a stale copy in git is a copy someone will ship
# without noticing it no longer matches what editors have published.
/lib/content/.snapshot/
/public/assets/cms/

# macOS
.DS_Store
