# Copy to .env and fill in. `npm run db:up` serves the default DATABASE_URI.

# Postgres. Matches docker-compose.yml; point it anywhere for a hosted database.
DATABASE_URI=postgres://movement:movement@localhost:5433/movement_studio

# Signs admin sessions and API keys. Any long random string; changing it logs everyone out.
# Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=

# Where this instance is reachable. Used for admin links and CORS.
NEXT_PUBLIC_SERVER_URL=http://localhost:3100

# The site's origin, allowed through CORS so a browser-side fetch would work.
# The build-time snapshot fetch is server-side and does not need it.
SITE_URL=https://www.movement-studio.pl

# --- Publishing (optional, leave unset locally) ---
# A content save POSTs a repository_dispatch to GitHub, which reruns the Pages
# workflow. Unset means saves publish nothing, which is what you want locally.
# Fine-grained PAT, repository permission "Contents: read and write".
GITHUB_DISPATCH_TOKEN=
# owner/repo the site deploys from.
GITHUB_DISPATCH_REPO=
